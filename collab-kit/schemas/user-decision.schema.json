{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "work_order_id",
    "round",
    "actor",
    "recorded_by",
    "recorded_at",
    "source",
    "user_text",
    "report_approvals",
    "query_resolutions"
  ],
  "properties": {
    "project": {
      "type": "string",
      "const": "{{PROJECT}}"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^WO-[0-9]{8}-[0-9]{3}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "const": "user"
    },
    "recorded_by": {
      "type": "string",
      "enum": [
        "Codex",
        "Claude"
      ],
      "description": "用户在哪个终端说的，就由哪一方如实记录"
    },
    "recorded_at": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "user_text": {
      "type": "string"
    },
    "report_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_round",
          "artifact_sha256",
          "verdict"
        ],
        "properties": {
          "report_round": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "pass_with_notes",
              "revise",
              "fail"
            ]
          }
        }
      }
    },
    "query_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_round",
          "artifact_sha256",
          "query_ids",
          "decision",
          "ruling"
        ],
        "properties": {
          "query_round": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept_codex",
              "reject",
              "revise",
              "defer"
            ]
          },
          "ruling": {
            "type": "string"
          }
        }
      }
    }
  }
}
